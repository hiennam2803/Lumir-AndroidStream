{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Quyền tối thiểu cho cửa sổ chính: kéo, thu nhỏ, phóng to, đóng (titlebar tự vẽ).",
  "windows": [
